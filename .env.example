# 复制为 .env 后按需修改。注意：.env 已被 .gitignore 排除，不要提交真实密钥

# 推理后端：ollama | openai | mock
LLM_PROVIDER=mock

# ---- 本地 Ollama ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.6
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=768
OLLAMA_TIMEOUT=300
# 模型在内存中保留时长，避免每次任务重新加载（冷启动约 20-30s）
OLLAMA_KEEP_ALIVE=30m

# ---- OpenAI 兼容接口（DeepSeek / 通义千问 / 智谱等）----
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat
OPENAI_TEMPERATURE=0.6
OPENAI_TIMEOUT=180

# ---- 协作流程 ----
# 测试/审查不通过时最多回流开发者几次
MAX_ITERATIONS=2
# 喂给模型的历史上下文预算（字符数），防止超出 num_ctx
MAX_CONTEXT_CHARS=6000
